# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# local dev logs
.next-dev.log
.next-dev.err.log
.dev-server*.log

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# UAT agent — auth sessions (contain Supabase tokens) and generated results
tests/uat/.auth/
tests/uat/results/
playwright-report/
test-results/

# local runtime artifacts
dev-server.log
tmp-*.png

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
supabase/.temp/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# pnpm — NEVER commit this file. Local pnpm 10/11 auto-creates it to record which packages may
# run install scripts (sharp, unrs-resolver), but amplify.yml builds with pnpm@9, which reads the
# same filename strictly as a MONOREPO config and aborts the build ("packages field missing or
# empty") before installing anything. It broke the Amplify build once already (ad9dc668,
# 2026-06-08) and reappeared, because "remember not to commit it" is not a real safeguard.
# It is also redundant: the native-dep build allowlist already lives in .npmrc.
pnpm-workspace.yaml

# env files (can opt-in for committing if needed)
.env*

# claude — personal per-machine permissions (shared config stays in .claude/settings.json)
.claude/settings.local.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
