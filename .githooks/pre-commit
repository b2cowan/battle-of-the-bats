#!/bin/sh
# Color-token guardrail — block commits that ADD hardcoded colors (hex OR brand rgba) to a
# guarded CSS module or component (they should be var(--token) from app/globals.css so a
# rebrand is one edit). Genuinely non-brand literals are annotated in place instead:
#   /* token-exempt: print-only neutral */
#
# Only files staged in THIS commit are checked, against their per-file baseline — so
# pre-existing debt (or another session's files) never blocks an unrelated commit. The
# script iterates every scope, so scopes added later need no edit here.
# Bypass (discouraged): `git commit --no-verify`. The Amplify deploy build re-runs the full
# --scope=all check as the authoritative, unbypassable backstop.
#
# Wired via `git config core.hooksPath .githooks` (set automatically by the package.json
# "prepare" script on `npm install`).
set -f  # disable globbing — guarded paths contain [orgSlug] / (consumer) etc.
files=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(module\.css|tsx)$')
[ -n "$files" ] && { node scripts/check-public-tokens.mjs --staged $files || exit 1; }

# Date-correctness guardrail — block calendar-day logic taken from the runtime timezone.
# Production runs UTC while orgs schedule in Toronto, so it reads a day late every evening,
# and a dev machine (on Toronto time) never sees it. Helpers live in lib/timezone.ts.
datefiles=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.tsx?$')
[ -n "$datefiles" ] && { node scripts/check-date-correctness.mjs --staged $datefiles || exit 1; }

# Rendered-document guardrail — the ONLY check in this repo that generates a PDF and looks at
# it. Every other gate reads source text or database state, which is how a squashed crest, a
# shredded heading, a lying page total and a run sheet printed across its own footer all shipped.
#
# TRIGGERED, NEVER SCHEDULED (owner ruling 2026-08-26). The script reads the staged list and
# returns instantly unless something that can change a document is in it — the export engine,
# the assemblers that feed it, its fixtures, or a screen that imports an exporter. ~3.5s when it
# runs, ~0.1s when it does not. It is deliberately NOT in `verify:changed`; the release
# checklist runs one full sweep before documents can reach a customer.
pdffiles=$(git diff --cached --name-only --diff-filter=ACM)
[ -n "$pdffiles" ] && { node --import ./scripts/lib/pdf-node-loader.mjs scripts/check-pdf-documents.mjs --staged $pdffiles || exit 1; }

# Lockfile-sync guardrail — block a dependency change committed WITHOUT its regenerated lockfile.
# The Amplify build installs with pnpm's CI default of --frozen-lockfile, so a package.json that
# names a package the lockfile has never heard of fails the deploy at install, before a line is
# compiled. It cannot be seen locally: the machine that added the package already has it in
# node_modules, and nothing else here reads the lockfile. That is dev job 267 (2026-08-27) —
# pdfjs-dist committed on its own, red build ninety seconds in.
#
# Reads the INDEX, not the working tree: the failure mode is a correct working copy where only
# package.json made it into the commit. Runs in milliseconds, offline, on every commit.
node scripts/check-lockfile-sync.mjs --staged || exit 1

exit 0
